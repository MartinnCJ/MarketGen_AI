# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME="NoonDalton AI Marketing Suite"
APP_ENV=development          # development | staging | production
APP_DEBUG=true
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Keycloak ──────────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=nd-marketing
KEYCLOAK_CLIENT_ID=nd-backend
KEYCLOAK_CLIENT_SECRET=your-client-secret-here

# ── Google Cloud / Firestore ──────────────────────────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_APPLICATION_CREDENTIALS=/app/service-account.json

FIRESTORE_DATABASE=(default)

# ── Gemini LLM ────────────────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyARnFR8hFNNtMkgQpMlu7hMkNxNO_z5Elk
GOOGLE_API_KEY=AIzaSyARnFR8hFNNtMkgQpMlu7hMkNxNO_z5Elk
GEMINI_DEFAULT_MODEL=gemini-2.0-flash
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.7

# ── Supabase Storage ──────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=nd-assets

# ── Redis / Celery ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
